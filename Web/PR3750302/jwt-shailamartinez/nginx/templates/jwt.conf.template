# Les variables ${DOMINI} les substitueix la imatge oficial de Nginx en arrencar
# (fitxers *.template de /etc/nginx/templates → /etc/nginx/conf.d)

server_tokens off;
limit_req_zone $binary_remote_addr zone=login:10m rate=5r/m;

# HTTP → HTTPS per a tots els subdominis
server {
    listen 80;
    server_name .${DOMINI};
    return 301 https://$host$request_uri;
}

# Peticions que no són per a cap dels nostres noms (escanejos per IP)
server {
    listen 443 ssl default_server;
    server_name _;
    include /etc/nginx/snippets/seguretat.conf;
    return 444;
}

# ---------- auth.DOMINI: emissió de tokens ----------
server {
    listen 443 ssl;
    http2 on;
    server_name auth.${DOMINI};
    include /etc/nginx/snippets/seguretat.conf;

    location = /login {
        limit_req zone=login burst=3 nodelay;
        limit_req_status 429;
        proxy_pass http://auth:5000;
        include /etc/nginx/snippets/proxy.conf;
    }

    # /verify és només per a ús intern de Nginx
    location = /verify {
        return 404;
    }

    location / {
        proxy_pass http://auth:5000;
        include /etc/nginx/snippets/proxy.conf;
    }
}

# ---------- api.DOMINI: l'API valida el token ella mateixa ----------
server {
    listen 443 ssl;
    http2 on;
    server_name api.${DOMINI};
    include /etc/nginx/snippets/seguretat.conf;
    add_header Cache-Control "no-store" always;

    location /api/ {
        proxy_pass http://api:5000;
        include /etc/nginx/snippets/proxy.conf;
    }

    location / {
        return 404;
    }
}

# ---------- app.DOMINI: Nginx valida el token amb auth_request ----------
server {
    listen 443 ssl;
    http2 on;
    server_name app.${DOMINI};
    include /etc/nginx/snippets/seguretat.conf;
    root /usr/share/nginx/html;

    location = /_verify {
        internal;
        proxy_pass http://auth:5000/verify;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header Cookie $http_cookie;
        proxy_set_header Authorization $http_authorization;
    }

    location / {
        auth_request /_verify;
        auth_request_set $usuari $upstream_http_x_user;
        auth_request_set $rol    $upstream_http_x_role;
        error_page 401 = @login;

        add_header X-Usuari $usuari always;
        add_header X-Rol    $rol always;
        add_header Cache-Control "no-store" always;
        try_files $uri $uri/ /index.html;
    }

    location @login {
        return 302 https://auth.${DOMINI}/login;
    }
}
